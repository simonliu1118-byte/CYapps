<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>CYInvoice</RootNamespace>
    <AssemblyName>CYInvoice</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <CanonicalApplicationIcon>$(BaseIntermediateOutputPath)canonical-icon\CYInvoice.ico</CanonicalApplicationIcon>
    <ApplicationIcon>$(CanonicalApplicationIcon)</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CYInvoice.Core\CYInvoice.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.16" />
    <EmbeddedResource Include="$(CanonicalApplicationIcon)" LogicalName="CYInvoice.AppIcon" />
    <Content Include="..\..\BUILD" Link="BUILD" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\VERSION" Link="VERSION" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PrepareCanonicalApplicationIcon" BeforeTargets="PrepareForBuild" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\prepare-canonical-icon.ps1&quot; -OutputPath &quot;$(MSBuildProjectDirectory)\$(CanonicalApplicationIcon)&quot;" />
  </Target>
</Project>
