<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests for the pure rules of CYERPAutoInput (no Win32 / WinForms / OCR).
    The source files are linked rather than referenced so the tests run on any OS.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>CYERPAutoInput.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\InputRules.cs" Link="Linked\InputRules.cs" />
    <Compile Include="..\..\OcrTextNormalizer.cs" Link="Linked\OcrTextNormalizer.cs" />
    <Compile Include="..\..\ErpDocumentState.cs" Link="Linked\ErpDocumentState.cs" />
    <Compile Include="..\..\XlsxReader.cs" Link="Linked\XlsxReader.cs" />
    <Compile Include="..\..\ShopeeOrderImport.cs" Link="Linked\ShopeeOrderImport.cs" />
    <Compile Include="..\..\XlsReader.cs" Link="Linked\XlsReader.cs" />
    <Compile Include="..\..\MoOrderImport.cs" Link="Linked\MoOrderImport.cs" />
    <Compile Include="..\..\ImportedOrder.cs" Link="Linked\ImportedOrder.cs" />
    <Compile Include="..\..\OrderLedger.cs" Link="Linked\OrderLedger.cs" />
    <Compile Include="..\..\CoupangOrderImport.cs" Link="Linked\CoupangOrderImport.cs" />
    <Compile Include="..\..\CompanyNameResponse.cs" Link="Linked\CompanyNameResponse.cs" />
    <Compile Include="..\..\ShopeeScreenshot.cs" Link="Linked\ShopeeScreenshot.cs" />
    <Compile Include="..\..\RibbonPrintLocator.cs" Link="Linked\RibbonPrintLocator.cs" />
    <Compile Include="..\..\ShopeePageScan.cs" Link="Linked\ShopeePageScan.cs" />
    <Compile Include="..\..\ShopeeBatchScreens.cs" Link="Linked\ShopeeBatchScreens.cs" />
    <Compile Include="..\..\ChatRules.cs" Link="Linked\ChatRules.cs" />
    <Compile Include="..\..\GiftRules.cs" Link="Linked\GiftRules.cs" />
    <Compile Include="..\..\SlipImage.cs" Link="Linked\SlipImage.cs" />
    <Compile Include="..\..\SlipNote.cs" Link="Linked\SlipNote.cs" />
    <Compile Include="..\..\MoBatchScreens.cs" Link="Linked\MoBatchScreens.cs" />
    <Compile Include="..\..\MoPickupSummary.cs" Link="Linked\MoPickupSummary.cs" />
    <Compile Include="..\..\CyInvoiceLink.cs" Link="Linked\CyInvoiceLink.cs" />
    <Compile Include="..\..\BatchSummary.cs" Link="Linked\BatchSummary.cs" />
    <Compile Include="..\..\CoupangScreens.cs" Link="Linked\CoupangScreens.cs" />
    <Compile Include="..\..\UpdateCheck.cs" Link="Linked\UpdateCheck.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fake, password-protected MO店+ exports built by Fixtures/make_mo_fixture.py. -->
    <None Include="Fixtures\*.xls" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
