<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
  <SolidColorBrush x:Key="Line" Color="#D1D5DB"/>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="SecondaryText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#667085"/>
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,5"/></Style>
  <Style TargetType="TextBox">
    <Setter Property="Padding" Value="7,5"/><Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#60A5FA"/></Trigger></Style.Triggers>
  </Style>
  <!-- Flat drop-down for the read-only ComboBoxes (the control, its keyboard/wheel behaviour and popup are the
       standard ComboBox; only the surface and arrow are drawn here). The app has no editable ComboBox: an
       editable one would need its text box part added to this template first. -->
  <ControlTemplate x:Key="CYComboToggle" TargetType="ToggleButton">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="1" CornerRadius="2">
      <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
            Data="M 0 0 L 4 4 L 8 0" Stroke="#667085" StrokeThickness="1.5"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#98A2B3"/></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="8,6"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#F1F3F5"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#DBEAFE"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Padding" Value="8,4,28,4"/><Setter Property="MinHeight" Value="32"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="#1F2937"/>
    <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid>
        <ToggleButton x:Name="Toggle" Template="{StaticResource CYComboToggle}" Focusable="False" ClickMode="Press"
                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
        <ContentPresenter x:Name="Content" IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
        <Border x:Name="Focus" Margin="1" CornerRadius="1" BorderThickness="1" BorderBrush="Transparent" IsHitTestVisible="False"/>
        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False"
               AllowsTransparency="True" PopupAnimation="Fade">
          <Border Margin="0,2,6,6" MinWidth="{Binding ActualWidth, ElementName=Toggle}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                  Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="2">
            <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
          </Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="#60A5FA"/></Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter TargetName="Toggle" Property="Background" Value="#F1F3F5"/>
          <Setter Property="Foreground" Value="#98A2B3"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Low-presence keyboard focus: a thin solid frame instead of the default black dotted rectangle. -->
  <Style x:Key="CYFocus">
    <Setter Property="Control.Template"><Setter.Value><ControlTemplate>
      <Rectangle Margin="-1" Stroke="#60A5FA" StrokeThickness="1" SnapsToDevicePixels="True" IsHitTestVisible="False"/>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- All buttons share one shape: the native Button control (click, keyboard, focus, accessibility)
       with a fixed 2 px rounded surface. Hover/pressed/focus change colour only, never geometry. -->
  <Style TargetType="Button">
    <Setter Property="Padding" Value="14,5"/><Setter Property="MinHeight" Value="34"/>
    <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    <Setter Property="Foreground" Value="#1F2937"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid>
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
        </Border>
        <Border x:Name="Focus" Margin="1" CornerRadius="1" BorderThickness="1" BorderBrush="Transparent" IsHitTestVisible="False"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="#60A5FA"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F1F3F5"/><Setter Property="BorderBrush" Value="#98A2B3"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#E5E8EC"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#F1F3F5"/><Setter Property="BorderBrush" Value="#E5E8EC"/><Setter Property="Foreground" Value="#98A2B3"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="#2563EB"/><Setter Property="BorderBrush" Value="#2563EB"/>
    <Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D4ED8"/><Setter Property="BorderBrush" Value="#1D4ED8"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#1E40AF"/><Setter Property="BorderBrush" Value="#1E40AF"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#F1F3F5"/><Setter Property="BorderBrush" Value="#D1D5DB"/><Setter Property="Foreground" Value="#98A2B3"/></Trigger>
    </Style.Triggers>
  </Style>
  <!-- Danger stays its own colour family (never the theme accent). Used for the one destructive key action. -->
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="#B43737"/><Setter Property="BorderBrush" Value="#B43737"/>
    <Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#9F2F2F"/><Setter Property="BorderBrush" Value="#9F2F2F"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#862727"/><Setter Property="BorderBrush" Value="#862727"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#F1F3F5"/><Setter Property="BorderBrush" Value="#D1D5DB"/><Setter Property="Foreground" Value="#98A2B3"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="ListBox"><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Background" Value="White"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,6"/><Setter Property="FocusVisualStyle" Value="{StaticResource CYFocus}"/></Style>
  <Style TargetType="CheckBox"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{StaticResource CYFocus}"/></Style>
  <Style TargetType="DataGrid">
    <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Background" Value="White"/>
    <Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
    <Setter Property="HorizontalGridLinesBrush" Value="#DDE1E6"/><Setter Property="VerticalGridLinesBrush" Value="#DDE1E6"/>
    <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="32"/>
    <Setter Property="ColumnHeaderHeight" Value="34"/><Setter Property="SelectionUnit" Value="FullRow"/>
    <Setter Property="SelectionMode" Value="Single"/><Setter Property="CanUserDeleteRows" Value="False"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="#F1F3F5"/><Setter Property="Foreground" Value="#1F2937"/>
    <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8,5"/>
    <Setter Property="BorderBrush" Value="#DDE1E6"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
  </Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="6,4"/><Setter Property="BorderThickness" Value="1"/>
    <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DBEAFE"/><Setter Property="Foreground" Value="#1F2937"/><Setter Property="BorderBrush" Value="Transparent"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#60A5FA"/></Trigger></Style.Triggers>
  </Style>
  <!-- Click areas over the printed mail-type table and frame: invisible until hovered or focused. -->
  <Style x:Key="TickTarget" TargetType="Button">
    <Setter Property="Background" Value="#01FFFFFF"/><Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="HitArea" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HitArea" Property="Background" Value="#332563EB"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HitArea" Property="BorderBrush" Value="#2563EB"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DirectTarget" TargetType="Button">
    <Setter Property="Background" Value="#0D2563EB"/><Setter Property="BorderBrush" Value="#802563EB"/>
    <Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="HitArea" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HitArea" Property="Background" Value="#262563EB"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HitArea" Property="BorderBrush" Value="#2563EB"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
