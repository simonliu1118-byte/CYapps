{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cycloud-identity-local-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cycloud-identity-local-test",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "local-test",
    "API_VERSION": "v1",
    "SESSION_TTL_SECONDS": "3600"
  }
}
