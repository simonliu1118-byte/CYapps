<Window x:Class="CYEnvelope.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CYEnvelope"
        Width="1140" Height="790" MinWidth="940" MinHeight="660" WindowStartupLocation="CenterScreen"
        Background="#F8FAFC" Foreground="#1F2937" FontFamily="Microsoft JhengHei UI" FontSize="15"
        Icon="/CYEnvelope;component/ENV.ico">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="MinHeight" Value="35"/>
      <Setter Property="Margin" Value="4"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="5,3"/>
      <Setter Property="Margin" Value="0,4,0,10"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Margin" Value="0,4,0,10"/>
    </Style>
  </Window.Resources>
  <DockPanel Margin="18">
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1" Padding="6,3" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal">
        <Button Content="聯絡人資料" Click="ContactsClick"/>
        <Button Content="列印設定" Click="PrinterClick"/>
        <Button Content="格式設定" Click="FormatClick"/>
        <Button Content="方框文字" Click="FrameClick"/>
        <Button Content="設定" Click="SettingsClick"/>
      </StackPanel>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="370"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Padding="16">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="列印" FontSize="17" FontWeight="SemiBold" Width="190" Height="46" Click="PrintClick"/>
            <Button Content="清空" Width="110" Click="ClearClick"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="收件資料" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <TextBlock Text="收件人"/>
              <TextBox x:Name="RecipientBox" TextChanged="RecipientChanged" KeyDown="RecipientKeyDown"/>
              <ListBox x:Name="Suggestions" MaxHeight="130" Visibility="Collapsed" MouseDoubleClick="SuggestionChosen"
                       KeyDown="SuggestionKeyDown" DisplayMemberPath="Name" Margin="0,0,0,10"/>
              <TextBlock Text="已存地址"/>
              <ComboBox x:Name="AddressChoice" DisplayMemberPath="Label" SelectionChanged="AddressChoiceChanged"/>
              <TextBlock Text="地址"/>
              <TextBox x:Name="AddressBox" TextChanged="InputChanged" LostKeyboardFocus="AddressLostFocus"
                       KeyDown="InputKeyDown" AcceptsReturn="False"/>
              <TextBlock Text="郵遞區號"/>
              <TextBox x:Name="PostalBox" MaxLength="3" Width="85" HorizontalAlignment="Left" TextChanged="InputChanged"/>
              <TextBlock Text="已存電話"/>
              <ComboBox x:Name="PhoneChoice" DisplayMemberPath="Display" SelectionChanged="PhoneChoiceChanged"/>
              <TextBlock Text="電話（選填）"/>
              <TextBox x:Name="PhoneBox" TextChanged="InputChanged" LostKeyboardFocus="PhoneLostFocus"/>
              <TextBlock Text="郵件種類" FontWeight="SemiBold" Margin="0,4,0,8"/>
              <WrapPanel x:Name="DeliveryPanel"/>
              <CheckBox x:Name="ShowFrameBox" Content="印出方框文字" Margin="0,16,0,8" Checked="InputChanged" Unchecked="InputChanged"/>
              <ComboBox x:Name="FrameChoice" SelectionChanged="InputChanged"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Padding="14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="信封預覽" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock x:Name="FormatName" Foreground="#667085" VerticalAlignment="Center" Margin="16,0,0,0"/>
          </StackPanel>
          <Viewbox Stretch="Uniform"><Border BorderBrush="#E5E8EC" BorderThickness="1">
            <local:VisualHost x:Name="PreviewHost" xmlns:local="clr-namespace:CYEnvelope"/>
          </Border></Viewbox>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
