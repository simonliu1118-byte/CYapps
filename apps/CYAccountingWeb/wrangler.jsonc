{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cyaccounting-web",
  "main": "src/app.js",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cyaccounting-web-db",
      "database_id": "e12bccbf-6c68-4639-8195-06591e8cf2f6"
    }
  ],
  "services": [
    {
      "binding": "IDENTITY",
      "service": "cyinvoice-cloud-dev"
    }
  ],
  "triggers": {
    "crons": [
      "30 19 * * *"
    ]
  }
}
