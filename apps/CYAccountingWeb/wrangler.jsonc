{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cyaccounting-web",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }

  // D1 binding will be added after the Cloudflare database is created.
  // Expected binding name: DB
  // Expected database name: cyaccounting-web-db
}
