{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "__CF_WORKER_NAME__",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/",
      "/index.html",
      "/login",
      "/login.html"
    ]
  },
  "routes": [
    {
      "pattern": "__CF_CUSTOM_DOMAIN__",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__CF_D1_DATABASE_NAME__",
      "database_id": "__CF_D1_DATABASE_ID__"
    }
  ],
  "services": [
    {
      "binding": "IDENTITY",
      "service": "__CF_IDENTITY_SERVICE__"
    }
  ],
  "vars": {
    "CYID_APPLICATION_ID": "__CF_CYID_APPLICATION_ID__",
    "CYID_WORKSPACE_ID": "__CF_CYID_WORKSPACE_ID__",
    "CYWEB_PORTAL_URL": "__CF_CYWEB_PORTAL_URL__",
    "CYPD_FETCHER_URL": "__CF_CYPD_FETCHER_URL__"
  }
}
