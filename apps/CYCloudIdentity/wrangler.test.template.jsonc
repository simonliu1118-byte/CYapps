{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cycloud-identity-local-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cycloud-identity-local-test",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "900001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "APP_ENV": "local-test",
    "API_VERSION": "v1",
    "SESSION_TTL_SECONDS": "3600",
    "EMAIL_DAILY_BUDGET": "50",
    "CORE_ACCOUNT_APPLICATION_ID": "APP_TEST_LOGIN",
    "ACCOUNT_PORTAL_URL": "https://portal.example.test/"
  }
}
